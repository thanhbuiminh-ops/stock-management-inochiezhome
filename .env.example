# Tất cả đặt trên NETLIFY (Site configuration > Environment variables), rồi deploy lại.

# --- Bảo vệ truy cập ---
# Chuỗi ngẫu nhiên >= 32 ký tự để ký cookie đăng nhập:  openssl rand -base64 48
SESSION_SECRET=
# Danh sách email Google được vào, ngăn cách bằng dấu phẩy:  a@gmail.com,b@congty.vn
ALLOWED_EMAILS=
# Đăng nhập bằng Google: Google Cloud > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URI:  https://<site-của-bạn>.netlify.app/api/auth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Google Sheet ---
# ID nằm trong URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=
# Tên tab chứa bảng (mặc định COGS)
SHEET_TAB=COGS
# Lấy từ file JSON của service account (client_email và private_key)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# --- Tuỳ chọn ---
# Bao lâu (giây) thì đọc lại Sheet khi có người đang xem. Tối thiểu 60, mặc định 300.
# REFRESH_AFTER_SEC=300
# Mặc định HIỆN COGS và "Giá trị tồn" cho mọi tài khoản đăng nhập. Đặt false để ẩn.
# INCLUDE_COST=true

# --- Cảnh báo tồn theo Forecast (Forecast nhập trên web, lưu trong Netlify Blobs) ---
# Tồn "sát plan" khi Tổng tồn < Nhu cầu × (1 + buffer%). Mặc định 20 — ĐÂY LÀ GIẢ ĐỊNH, chỉnh theo thực tế.
# PLAN_BUFFER_PCT=20
# % nhu cầu dự kiến xuất từ kho Nam; kho Nam cần có tồn >= Nhu cầu × tỉ lệ này. Mặc định 70 — ĐÂY LÀ GIẢ ĐỊNH, chỉnh theo thực tế.
# PLAN_SOUTH_SHARE_PCT=70
